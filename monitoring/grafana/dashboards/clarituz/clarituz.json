{
  "uid": "clarituz-overview",
  "title": "Clarituz — Produção",
  "tags": ["clarituz", "pousada"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "API — req/s",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(axum_http_requests_total[5m]))", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 1}, "overrides": []}
    },
    {
      "id": 2, "type": "stat", "title": "5xx — taxa",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"refId": "A", "expr": "100 * sum(rate(axum_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(axum_http_requests_total[5m]))", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 2}]}}, "overrides": []}
    },
    {
      "id": 3, "type": "stat", "title": "SSE subscribers",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"refId": "A", "expr": "clarituz_sse_subscribers", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 4, "type": "stat", "title": "Pool idle",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "clarituz_db_pool_idle", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 5, "type": "stat", "title": "Maria — turnos/min",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{"refId": "A", "expr": "rate(maria_turnos_total[5m]) * 60", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 1}, "overrides": []}
    },
    {
      "id": 6, "type": "stat", "title": "PG conexões",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(pg_stat_activity_count)", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 80}]}}, "overrides": []}
    },
    {
      "id": 7, "type": "timeseries", "title": "API — latência p50/p95/p99",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(axum_http_requests_duration_seconds_bucket[5m])))", "legendFormat": "p50", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(axum_http_requests_duration_seconds_bucket[5m])))", "legendFormat": "p95", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(axum_http_requests_duration_seconds_bucket[5m])))", "legendFormat": "p99", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 8, "type": "timeseries", "title": "API — req/s por status",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(axum_http_requests_total[5m]))", "legendFormat": "{{status}}", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 9, "type": "timeseries", "title": "Pool Postgres — conexões vs ociosas",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"refId": "A", "expr": "clarituz_db_pool_connections", "legendFormat": "em uso ({{instance}})", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}},
        {"refId": "B", "expr": "clarituz_db_pool_idle", "legendFormat": "ociosas ({{instance}})", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}},
        {"refId": "C", "expr": "clarituz_db_pool_max", "legendFormat": "teto ({{instance}})", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 10, "type": "timeseries", "title": "API — top rotas por req/s",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [{"refId": "A", "expr": "topk(8, sum by (endpoint) (rate(axum_http_requests_total[5m])))", "legendFormat": "{{endpoint}}", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 11, "type": "timeseries", "title": "Maria — latência por estágio",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [{"refId": "A", "expr": "maria_latencia_segundos", "legendFormat": "{{estagio}} {{medida}}", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 12, "type": "timeseries", "title": "Maria — tool calls/min",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [{"refId": "A", "expr": "rate(maria_tool_calls_total[5m]) * 60", "legendFormat": "{{tool}}", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 13, "type": "timeseries", "title": "Postgres — tamanho dos databases",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "targets": [{"refId": "A", "expr": "pg_database_size_bytes{datname!~\"template.*|postgres\"}", "legendFormat": "{{datname}}", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 14, "type": "timeseries", "title": "SSE subscribers por réplica",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [{"refId": "A", "expr": "clarituz_sse_subscribers", "legendFormat": "{{instance}}", "datasource": {"type": "prometheus", "uid": "clarituz-prom"}}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}
