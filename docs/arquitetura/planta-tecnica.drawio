e UI;fontSize=10;fillColor=#1E3A5F;fontColor=#FFFFFF;strokeColor=#1E3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="160" height="60" as="geometry"/></mxCell><mxCell id="c20" value="2. Trigger PG dispara&amp;#10;pg_notify()" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="230" y="235" width="160" height="60" as="geometry"/></mxCell><mxCell id="c21" value="3. api eventos.rs&amp;#10;LISTEN clarituz_delta&amp;#10;clarituz_aviso" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#1E3A5F;fontColor=#FFFFFF;strokeColor=#1E3A5F;" vertex="1" parent="1"><mxGeometry x="420" y="235" width="170" height="60" as="geometry"/></mxCell><mxCell id="c22" value="4. Fan-out p/ WS&amp;#10;dos admins conectados" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#1E3A5F;fontColor=#FFFFFF;strokeColor=#1E3A5F;" vertex="1" parent="1"><mxGeometry x="620" y="235" width="160" height="60" as="geometry"/></mxCell><mxCell id="c23" value="5. Realtime.delta(&#x27;tabela&#x27;)&amp;#10;→ effect() recarrega&amp;#10;só o que mudou" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="810" y="235" width="200" height="60" as="geometry"/></mxCell><mxCell id="c24" value="⚠ gap conhecido: NOTIFY&amp;#10;é por conexão — com &gt;1 réplica&amp;#10;parte dos eventos se perde.&amp;#10;Plano: Redis Pub/Sub." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1040" y="235" width="200" height="60" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=9;fontColor=#444444;endArrow=block;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=9;fontColor=#444444;endArrow=block;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=9;fontColor=#444444;endArrow=block;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=9;fontColor=#444444;endArrow=block;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=9;fontColor=#444444;endArrow=block;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="C. Turno de voz MAR IA (quando habilitado)" style="text;html=1;fontFamily=Segoe UI;fontSize=13;fontColor=#0E7C7B;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="500" height="20" as="geometry"/></mxCell><mxCell id="c31" value="1. mic → PCM16&amp;#10;24kHz via WS" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="140" height="60" as="geometry"/></mxCell><mxCell id="c32" value="2. VAD: webrtcvad&amp;#10;(frame→16k) + energia&amp;#10;pre-roll 300ms" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#0E7C7B;fontColor=#FFFFFF;strokeColor=#0E7C7B;" vertex="1" parent="1"><mxGeometry x="200" y="375" width="160" height="60" as="geometry"/></mxCell><mxCell id="c33" value="3. STT: resample→16k&amp;#10;float32, faster-whisper&amp;#10;em executor (fim da fala)" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#0E7C7B;fontColor=#FFFFFF;strokeColor=#0E7C7B;" vertex="1" parent="1"><mxGeometry x="380" y="375" width="160" height="60" as="geometry"/></mxCell><mxCell id="c34" value="4. LLM: gpt-5.2&amp;#10;+ tools + RAG&amp;#10;(fallback Cerebras)" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#0E7C7B;fontColor=#FFFFFF;strokeColor=#0E7C7B;" vertex="1" parent="1"><mxGeometry x="560" y="375" width="160" height="60" as="geometry"/></mxCell><mxCell id="c35" value="5. Se ação: preparar_*&amp;#10;→ staff confirma →&amp;#10;confirmar_acao → API" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#1E3A5F;fontColor=#FFFFFF;strokeColor=#1E3A5F;" vertex="1" parent="1"><mxGeometry x="740" y="375" width="160" height="60" as="geometry"/></mxCell><mxCell id="c36" value="6. TTS por frase&amp;#10;(Piper/Eleven) →&amp;#10;resample→24k" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#0E7C7B;fontColor=#FFFFFF;strokeColor=#0E7C7B;" vertex="1" parent="1"><mxGeometry x="920" y="375" width="160" height="60" as="geometry"/></mxCell><mxCell id="c37" value="7. PCM p/ speaker&amp;#10;+ transcript salva" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1100" y="375" width="160" height="60" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=9;fontColor=#444444;endArrow=block;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=9;fontColor=#444444;endArrow=block;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=9;fontColor=#444444;endArrow=block;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=9;fontColor=#444444;endArrow=block;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=9;fontColor=#444444;endArrow=block;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;fontSize=9;fontColor=#444444;endArrow=block;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="D. Rotinas de operação" style="text;html=1;fontFamily=Segoe UI;fontSize=13;fontColor=#1E3A5F;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="500" height="20" as="geometry"/></mxCell><mxCell id="c45" value="Backup Postgres (diário ~04:00 UTC)&amp;#10;scheduler → pg_dump --format=custom&amp;#10;(cliente 18 ≥ server) → upload S3&amp;#10;prefixo datado → retenção por contagem" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="515" width="280" height="90" as="geometry"/></mxCell><mxCell id="c46" value="Alerta de erro 5xx&amp;#10;middleware observa status → spawn async&amp;#10;dedup (método+rota_mask+status) 5min&amp;#10;cap global 20/60s · falha ≠ afeta resposta" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="350" y="515" width="280" height="90" as="geometry"/></mxCell><mxCell id="c47" value="Rate limit login&amp;#10;IP (X-Forwarded-For→ConnectInfo)&amp;#10;janela fixa 60s · default 10 tentativas&amp;#10;429 + Retry-After" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="660" y="515" width="280" height="90" as="geometry"/></mxCell><mxCell id="c48" value="Auth refresh (admin)&amp;#10;401 → single-flight refresh&amp;#10;(1 chamada p/ N requests pendentes)&amp;#10;falha → logout → /login" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="970" y="515" width="280" height="90" as="geometry"/></mxCell><mxCell id="c49" value="Algoritmos &amp; invariantes-chave" style="swimlane;html=1;startSize=26;fontFamily=Segoe UI;fontSize=11;fontStyle=1;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1210" height="330" as="geometry"/></mxCell><mxCell id="c50" value="Idempotência webhook: inbox pagamento_webhook_evento com UNIQUE(event_id) + ON CONFLICT DO NOTHING — reenvios do PSP são no-op; event_id vazio não colide (guard).&amp;#10;Migrations: sqlx::migrate! no boot com checksum por arquivo — conteúdo modificado aborta o boot (defesa). Line-ending é byte-significativo: *.sql fixado em LF via .gitattributes.&amp;#10;RAG híbrido (knowledge.py): busca vetorial + lexical combinadas; índice por hash de arquivo — só re-embeda o que mudou.&amp;#10;Rolling summary (session.py): histórico descartado vira resumo em vez de truncar — contexto longo sem perder início da conversa.&amp;#10;Cache semântico de reads: respostas de tools de leitura cacheadas por sessão; invalidado após qualquer escrita.&amp;#10;Two-phase action (HITL): preparar_* só valida + staged em Redis pend:; escrita real só via confirmar_acao do humano — LLM nunca escreve direto.&amp;#10;VAD composto: webrtcvad exige 8/16/32/48k — cada frame 24k resampleado p/ 16k antes; fallback energia se lib indisponível; pre-roll evita clipar ataque da fala.&amp;#10;Dedup de alerta: chave (método, rota_mask, status) com TTL 5min em memória; cap 20/min global; suprimidos logam warn.&amp;#10;Fixed-window rate limit: bucket por IP, Retry-After = resto da janela; X-Forwarded-For → ConnectInfo fallback.&amp;#10;Single-flight refresh: N requests 401 concorrentes → 1 chamada /auth/refresh compartilhada; fila desbloqueia junto.&amp;#10;Sum types de domínio: enums Rust com match exaustivo — transição inválida de estado de reserva/comanda vira erro de compilação.&amp;#10;Executor isolation: ONNX/whisper rodam em run_in_executor — event loop nunca bloqueia por inferência.&amp;#10;Circuit breaker LLM: falhas consecutivas abrem circuito → failover Cerebras; estado visível em /healthz." style="text;html=1;fontFamily=Segoe UI;fontSize=10;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="1180" height="280" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>