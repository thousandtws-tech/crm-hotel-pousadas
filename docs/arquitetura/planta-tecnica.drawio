pré-reserva&amp;#10;(hold + expiração)" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#1E3A5F;fontColor=#FFFFFF;strokeColor=#1E3A5F;" vertex="1" parent="1"><mxGeometry x="210" y="95" width="150" height="60" as="geometry"/></mxCell><mxCell id="c5" value="3. Redireciona&amp;#10;Stripe Checkout" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="380" y="95" width="150" height="60" as="geometry"/></mxCell><mxCell id="c6" value="4. Stripe cobra&amp;#10;e dispara webhook" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="550" y="95" width="150" height="60" as="geometry"/></mxCell><mxCell id="c7" value="5. POST /pagamentos&amp;#10;/webhook — verifica&amp;#10;assinatura" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#1E3A5F;fontColor=#FFFFFF;strokeColor=#1E3A5F;" vertex="1" parent="1"><mxGeometry x="720" y="95" width="170" height="60" as="geometry"/></mxCell><mxCell id="c8" value="6. Inbox: event_id único&amp;#10;ON CONFLICT DO NOTHING&amp;#10;duplicado → 200 sem reprocesso&amp;#10;event_id vazio → log + processa" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#1E3A5F;fontColor=#FFFFFF;strokeColor=#1E3A5F;" vertex="1" parent="1"><mxGeometry x="910" y="95" width="190" height="60" as="geometry"/></mxCell><mxCell id="c9" value="7. Confirma reserva&amp;#10;marca processado_em" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1120" y="95" width="150" height="60" as="geometry"/></mxCell><mxCell id="c10" value="8. NOTIFY → admin&amp;#10;atualiza em tempo real" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeo