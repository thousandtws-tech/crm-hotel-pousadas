server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Arquivos com hash do build Angular (main-XXXXXXXX.js, chunk-*.js,
    # styles-*.css, media/*): conteúdo novo = nome novo → cache longo seguro.
    # O separador do hash é hífen (main-RAELJMRL.js), não ponto.
    location ~* "-[0-9a-zA-Z_-]{8}\.(js|css)$" {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Nome de arquivo com hash também vale para media/* do outputPath.
    location ~* "/media/.*-[0-9a-zA-Z_-]{8}\.[a-zA-Z0-9]+$" {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Service worker, manifesto do SW e web manifest nunca cacheados:
    # é assim que cada deploy é descoberto (update check do PWA).
    location ~* /(ngsw-worker|safety-worker|worker-basic\.min)\.js$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location = /ngsw.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    # index.html sem cache: referencia chunks com hash que mudam a cada deploy.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }
    location = / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri /index.html =404;
    }

    # Assets sem hash (favicon.svg, logo.svg, icons/*, fontes locais):
    # revalida sempre — barato, e deploy novo aparece na hora.
    location ~* \.(png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|otf|json)$ {
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
