# --- MAR IA · Pousada Espírito do Mar ---

# URL base da API do sistema (backend Rust/Axum)
# Local:  http://localhost:8080/api/v1
# Railway (mesmo projeto): SEMPRE a rede privada — http://api.railway.internal:8080/api/v1
#   (usar https://api-*.up.railway.app gera egress cobrado entre serviços)
API_BASE=http://localhost:8080/api/v1

# Mesmo segredo HS256 do backend — fast-path de validação do JWT.
# Se estiver vazio ou divergir do backend, o serviço valida o token
# chamando GET /auth/me na própria API (introspecção).
# NUNCA exponha em frontend nem comite o valor real.
JWT_SECRET=troque-pelo-mesmo-valor-do-backend

# --- OpenAI ---
OPENAI_API_KEY=
# Modelo de raciocínio (Responses API)
OPENAI_LLM_MODEL=gpt-5.2
# Sessão realtime (query ?model=) — versão GA
OPENAI_REALTIME_MODEL=gpt-realtime-mini
# Modelo de transcrição (audio.input.transcription.model)
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Dica de vocabulario p/ a transcricao (audio.input.transcription.prompt)
# — termos do dominio melhoram a precisao em fala rapida
OPENAI_TRANSCRIPTION_PROMPT=Conversa em portugues do Brasil sobre gestao de pousada: check-in, check-out, reserva, hospede, suite, diaria, frigobar, comanda, PDV, caixa, sangria, FNRH, cafe da manha, estoque, Pousada Espirito do Mar, Maria.
# Modelo reserva do LLM — refaz o turno se o principal falhar antes do
# primeiro token emitido (ex.: gpt-5-mini). Vazio = sem fallback.
OPENAI_LLM_FALLBACK_MODEL=

# Fallback multi-provedor — Cerebras (OpenAI-compatível, Chat Completions).
# Wafer-scale: latência de tokens muito baixa, ideal p/ voz. Ativa quando
# CEREBRAS_API_KEY + CEREBRAS_MODEL estão preenchidos — vira o último elo
# da cadeia (OpenAI → OPENAI_LLM_FALLBACK_MODEL → Cerebras).
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

# Estado compartilhado entre réplicas — pendentes de confirmação,
# cache de leituras, histórico de conversa e cotas passam a viver no
# Redis (qualquer réplica confirma/responde). Vazio = tudo em memória
# de processo — uma réplica só.
REDIS_URL=

# TTL do histórico persistido por usuário (reconexão retoma conversa)
MARIA_HIST_TTL_SECS=14400

# Controle de custo por usuário — 0 = desligado
MARIA_RATE_TURNOS_MIN=0
MARIA_BUDGET_TOKENS_DIA=0

# Busca híbrida da base de conhecimento (vetor + BM25 via RRF).
# Com ela, a busca responde até sem embeddings indexados.
MARIA_RAG_HYBRID=true

# Tracing OpenTelemetry (OTLP/HTTP) — Tempo, Jaeger, Datadog, Langfuse.
# Vazio = desligado (custo zero).
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=maria-ia
# Esforço de raciocínio da Responses API: low = TTFT bem menor (ideal p/ voz).
# none desativa o parâmetro; minimal|low|medium|high|xhigh
OPENAI_LLM_REASONING_EFFORT=low
# true = server_vad; false = o cliente sinaliza fim de fala (commit manual)
OPENAI_SERVER_VAD=true
# VAD server-side — quanto menor o silêncio, mais rápida a resposta.
# threshold 0.0–1.0 (maior = mais exigente), prefixo/silêncio em ms
OPENAI_VAD_THRESHOLD=0.5
OPENAI_VAD_PREFIX_MS=300
OPENAI_VAD_SILENCE_MS=450
# Redução de ruído da Realtime: near_field | far_field | off
OPENAI_NOISE_REDUCTION=near_field

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = baixa latência + pt-BR; turbo_v2_5 alternativa
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_SPEED=1.0

# --- MAR IA ---
MARIA_VOICE_ENABLED=true
MARIA_DEFAULT_LANGUAGE=pt-BR
MARIA_HISTORY_ENABLED=true
MARIA_HISTORY_MAX_TURNS=12
# Teto de contexto: historico tambem corta por tamanho (chars)
MARIA_HISTORY_MAX_CHARS=24000
# Corte por saida de ferramenta devolvida ao modelo (chars)
MARIA_TOOL_RESULT_MAX_CHARS=6000
# Cache de leituras na sessao (TTL em segundos) — repeticoes nao
# refazem a chamada a API; qualquer escrita invalida o cache
MARIA_TOOL_CACHE_ENABLED=true
MARIA_TOOL_CACHE_TTL_SECS=45
# Rolling summary — pares cortados do historico viram resumo (LLM)
MARIA_SUMMARY_ENABLED=true
MARIA_HOST=0.0.0.0
MARIA_PORT=8090
# Origens CORS permitidas (vírgula-separadas). Em produção, liste a
# origem real do admin — NUNCA "*"
MARIA_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Teto de uso por sessão (proteção de custo): turnos LLM por conexão
# e tokens (entrada+saída) por turno
MARIA_LIMITE_TURNOS_SESSAO=200
MARIA_LIMITE_TOKENS_TURNO=40000
# Fuso para resolver "hoje/amanhã/sexta" nas ferramentas
MARIA_TIMEZONE=America/Sao_Paulo

# Fillers falados ("deixa eu ver…") enquanto as tools rodam — corta o
# silêncio percebido e humaniza o turno
MARIA_FILLER_ENABLED=true
# Tools independentes na mesma rodada do LLM executam em paralelo
MARIA_PARALLEL_TOOLS=true
# Diário de turnos em JSONL — alimenta o dataset de avaliação/treino
# (evals/). Campos sensíveis (senha, cpf, token…) são redigidos.
MARIA_TRANSCRIPT_ENABLED=true
MARIA_TRANSCRIPT_FILE=data/turns.jsonl
MARIA_TRANSCRIPT_MAX_BYTES=10485760

# RAG — base de conhecimento (.md versionados; políticas, horários,
# procedimentos). Ferramenta buscar_conhecimento consulta por
# similaridade de embedding; vetores cacheados no store (abaixo)
MARIA_RAG_ENABLED=true
MARIA_RAG_DIR=knowledge
MARIA_RAG_TOP_K=4
MARIA_RAG_MIN_SCORE=0.25
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Persistência (memórias, turnos, cache de embeddings, métricas) ---
# "json"  → um arquivo por coleção em data/ (padrão, dev/local)
# "sqlite" → MARIA_SQLITE_FILE — suporta volume/múltiplas instâncias;
#            migra os JSONs legados automaticamente na 1ª abertura.
# Métricas: snapshot persistido a cada 60s + no shutdown (restaura no
# boot) e expostas em GET /metrics.prom (formato Prometheus).
MARIA_STORAGE=json
MARIA_SQLITE_FILE=data/maria.db

# --- Backup do data/ (S3-compatível: AWS S3 ou MinIO) ---
# A cada MARIA_BACKUP_INTERVAL_H horas, envia dump portável do store +
# arquivos de data/ para s3://BUCKET/PREFIX/<AAAA-MM-DD>/ e mantém os
# últimos MARIA_BACKUP_RETAIN dias. MinIO: preencha MARIA_S3_ENDPOINT
# (ex.: http://minio:9000). AWS S3: deixe o endpoint vazio.
MARIA_BACKUP_ENABLED=false
MARIA_BACKUP_INTERVAL_H=24
MARIA_BACKUP_RETAIN=14
MARIA_S3_ENDPOINT=
MARIA_S3_BUCKET=
MARIA_S3_PREFIX=maria
MARIA_S3_REGION=us-east-1
MARIA_S3_ACCESS_KEY=
MARIA_S3_SECRET_KEY=

# Fine-tuning — snapshot do modelo base dos jobs (finetune/jobs.py).
# Ao concluir um job, aponte OPENAI_LLM_MODEL para o ft:... gerado
OPENAI_FT_BASE_MODEL=gpt-4o-mini-2024-07-18
