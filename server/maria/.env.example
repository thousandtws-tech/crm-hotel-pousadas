# --- MAR IA · Pousada Espírito do Mar ---

# URL base da API do sistema (backend Rust/Axum)
API_BASE=http://localhost:8080/api/v1

# Mesmo segredo HS256 do backend — fast-path de validação do JWT.
# Se estiver vazio ou divergir do backend, o serviço valida o token
# chamando GET /auth/me na própria API (introspecção).
# NUNCA exponha em frontend nem comite o valor real.
JWT_SECRET=troque-pelo-mesmo-valor-do-backend

# --- OpenAI ---
OPENAI_API_KEY=
# Modelo de raciocínio (Responses API)
OPENAI_LLM_MODEL=gpt-5.2
# Sessão realtime (query ?model=) — versão GA
OPENAI_REALTIME_MODEL=gpt-realtime-mini
# Modelo de transcrição (audio.input.transcription.model)
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# true = server_vad; false = o cliente sinaliza fim de fala (commit manual)
OPENAI_SERVER_VAD=true
# Redução de ruído da Realtime: near_field | far_field | off
OPENAI_NOISE_REDUCTION=near_field

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = baixa latência + pt-BR; turbo_v2_5 alternativa
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_SPEED=1.0

# --- MAR IA ---
MARIA_VOICE_ENABLED=true
MARIA_DEFAULT_LANGUAGE=pt-BR
MARIA_HISTORY_ENABLED=true
MARIA_HISTORY_MAX_TURNS=12
MARIA_HOST=0.0.0.0
MARIA_PORT=8090
# Fuso para resolver "hoje/amanhã/sexta" nas ferramentas
MARIA_TIMEZONE=America/Sao_Paulo
