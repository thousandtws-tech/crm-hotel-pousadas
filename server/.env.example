# ---- servidor ----
HTTP_ADDR=0.0.0.0:8080

# ---- banco ----
DATABASE_URL=postgres://clarituz:clarituz@localhost:5432/clarituz
DB_MAX_CONNECTIONS=10

# ---- segurança ----
# OBRIGATÓRIO: mínimo 32 caracteres. Gere: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-48+-chars-aleatorios
JWT_TTL_SECS=3600
REFRESH_TTL_SECS=2592000

# ---- http ----
# vírgula-separado ou * (dev)
CORS_ORIGINS=*

# ---- observabilidade ----
RUST_LOG=info,tower_http=debug,sqlx=warn

# ---- arquivos (comprovantes, logo) ----
STORAGE_DIR=./storage
