# ---- servidor ----
HTTP_ADDR=0.0.0.0:8080

# ---- banco ----
# Local: postgres://clarituz:clarituz@localhost:5432/clarituz
# Railway: sempre o host privado postgres.railway.internal (egress cobrado no proxy público)
DATABASE_URL=postgres://clarituz:clarituz@localhost:5432/clarituz
DB_MAX_CONNECTIONS=10

# ---- segurança ----
# OBRIGATÓRIO: mínimo 32 caracteres. Gere: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-48+-chars-aleatorios
JWT_TTL_SECS=3600
REFRESH_TTL_SECS=2592000

# ---- http ----
# vírgula-separado ou * (dev)
CORS_ORIGINS=*

# ---- observabilidade ----
RUST_LOG=info,tower_http=debug,sqlx=warn
# Webhook Discord/Slack p/ alerta de 5xx (fire-and-forget, dedup 5min por
# rota, teto 20/min). Sem a var o layer de alerta nem é instalado.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ---- hardening ----
# Teto de tentativas de login por IP/minuto (429 + Retry-After). Default 10.
# LOGIN_RATE_LIMIT_PER_MIN=10

# ---- arquivos (comprovantes, logo) ----
STORAGE_DIR=./storage

# ---- pagamentos online (Stripe) ----
# Sem STRIPE_SECRET_KEY a API sobe normalmente — checkout online desativado.
# Chaves NUNCA no código/git: somente nas variáveis do serviço no Railway.
#   sk_test_… homologação · sk_live_… produção (ativar só com autorização)
# STRIPE_SECRET_KEY=sk_test_troque-me
# STRIPE_WEBHOOK_SECRET=whsec_troque-me   # do endpoint no Dashboard (ou via API)
# STRIPE_SUCCESS_URL=https://espiritodomar.com.br/reserva/pagamento/sucesso
# STRIPE_CANCEL_URL=https://espiritodomar.com.br/reserva/pagamento/cancelado
# SINAL_PERCENTUAL=30    # % do sinal/entrada (0-100)
# HOLD_MINUTOS=30        # duração da reserva provisória aguardando pagamento

# ---- integrações de pagamento (Configurações → Integrações) ----
# Cofre AES-256-GCM das credenciais persistidas (PagBank/Stripe/Mercado Pago).
# Sem esta chave o módulo de integrações fica indisponível (503) e o checkout
# segue no Stripe legado do env acima. Gere uma vez e guarde no gerenciador:
#   openssl rand -hex 32
# Rotacionar a chave exige re-salvar as credenciais de cada integração.
# INTEGRACOES_MASTER_KEY=64-caracteres-hex-troque-me

# -- Comunicação (opcional — sem credenciais a fila acumula e retenta) ----------
# SITE_BASE=https://espiritodomar.com.br        # origem dos links /fnrh /avaliacao /checkout-online
# POUSADA_NOME=Pousada Espírito do Mar
# RESEND_API_KEY=re_...                         # e-mails transacionais (Resend)
# WHATSAPP_TOKEN=EAAG...                        # Meta Cloud API — token permanente
# WHATSAPP_PHONE_ID=1234567890                  # Phone Number ID da pousada
# VAPID_PRIVATE_PEM=-----BEGIN PRIVATE KEY----- # openssl ecparam -name prime256v1 -genkey
# VAPID_PUBLIC_B64=BD...                        # ponto público 65B base64url
# VAPID_CONTATO=mailto:contato@espiritodomar.com.br
