# ---- servidor ----
HTTP_ADDR=0.0.0.0:8080

# ---- banco ----
# Local: postgres://clarituz:clarituz@localhost:5432/clarituz
# Railway: sempre o host privado postgres.railway.internal (egress cobrado no proxy público)
DATABASE_URL=postgres://clarituz:clarituz@localhost:5432/clarituz
DB_MAX_CONNECTIONS=10

# ---- segurança ----
# OBRIGATÓRIO: mínimo 32 caracteres. Gere: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-48+-chars-aleatorios
JWT_TTL_SECS=3600
REFRESH_TTL_SECS=2592000

# ---- http ----
# vírgula-separado ou * (dev)
CORS_ORIGINS=*

# ---- observabilidade ----
RUST_LOG=info,tower_http=debug,sqlx=warn

# ---- arquivos (comprovantes, logo) ----
STORAGE_DIR=./storage

# ---- pagamentos online (Stripe) ----
# Sem STRIPE_SECRET_KEY a API sobe normalmente — checkout online desativado.
# Chaves NUNCA no código/git: somente nas variáveis do serviço no Railway.
#   sk_test_… homologação · sk_live_… produção (ativar só com autorização)
# STRIPE_SECRET_KEY=sk_test_troque-me
# STRIPE_WEBHOOK_SECRET=whsec_troque-me   # do endpoint no Dashboard (ou via API)
# STRIPE_SUCCESS_URL=https://espiritodomar.com.br/reserva/pagamento/sucesso
# STRIPE_CANCEL_URL=https://espiritodomar.com.br/reserva/pagamento/cancelado
# SINAL_PERCENTUAL=30    # % do sinal/entrada (0-100)
# HOLD_MINUTOS=30        # duração da reserva provisória aguardando pagamento
