# Realtime hub (Phoenix) — variáveis de ambiente
#
# JWT_SECRET precisa ser o MESMO da clarituz-api (o hub valida os tokens
# que a API emite). Nunca commitar valores reais.

JWT_SECRET=troque-pelo-mesmo-segredo-da-api-min-32-chars
DATABASE_URL=postgres://clarituz:clarituz@localhost:5432/clarituz

# Token compartilhado: serviços internos publicam via POST /api/ingest
INGEST_TOKEN=gere-um-token-longo-aleatorio

# Origens permitidas no handshake WebSocket (domínios dos frontends)
# CHECK_ORIGIN=https://admin-xxx.up.railway.app,https://web-xxx.up.railway.app

# Phoenix
SECRET_KEY_BASE=gere-com-mix-phx.gen.secret
PHX_HOST=realtime-xxx.up.railway.app
PORT=4000
